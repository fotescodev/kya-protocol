              "children": [
                {
                  "type": "text",
                  "id": "441EW",
                  "name": "problemT1",
                  "fill": "#FFFFFF",
                  "content": "The agentic economy has a ",
                  "fontFamily": "Oswald",
                  "fontSize": 40,
                  "fontWeight": "700",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "9HOM9",
                  "name": "problemT2",
                  "fill": "#FF6B35",
                  "content": "trust problem",
                  "fontFamily": "Oswald",
                  "fontSize": 40,
                  "fontWeight": "700",
                  "letterSpacing": 1
                }
              ]
            },
            {
              "type": "text",
              "id": "eZJTV",
              "name": "problemDesc",
              "fill": "#666666",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "When an AI agent requests a $50 purchase on your behalf, how does the merchant verify its authority? When agents transact with each other, how do they establish trust?",
              "lineHeight": 1.7,
              "fontFamily": "JetBrains Mono",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "AtzWK",
              "name": "problemSub",
              "fill": "#444444",
              "textGrowth": "fixed-width",
              "width": 700,
              "content": "Infrastructure exists for agents to pay and communicate. What's missing is a verifiable, portable identity layer.",
              "lineHeight": 1.5,
              "fontFamily": "JetBrains Mono",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
