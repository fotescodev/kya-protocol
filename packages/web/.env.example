# x402 + KYA Demo Configuration

# Base Sepolia RPC URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# WalletConnect Project ID (get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Wallet address to receive x402 payments
PAYMENT_WALLET_ADDRESS=0x_your_payment_wallet_address

# x402 Facilitator URL
X402_FACILITATOR_URL=https://x402.org/facilitator

# Demo Agent Attestation UIDs (populated after running setup script)
NEXT_PUBLIC_DEMO_IDENTITY_UID=0x_identity_attestation_uid
NEXT_PUBLIC_DEMO_CAPABILITY_UID=0x_capability_attestation_uid  
NEXT_PUBLIC_DEMO_DELEGATION_UID=0x_delegation_attestation_uid

# Demo wallet private key (for creating attestations - NEVER commit real keys)
DEMO_PRIVATE_KEY=0x_your_testnet_private_key
